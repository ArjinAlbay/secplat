# Local host-side development configuration (overrides .env)
# Start DB & Redis in Docker: make services (or docker compose up -d postgres redis)

SECPLAT_DATABASE_URL=postgresql+psycopg://secplat:devpass@localhost:5434/secplat
SECPLAT_REDIS_URL=redis://localhost:6379/0
SECPLAT_NUCLEI_BIN=nuclei
SECPLAT_NUCLEI_TEMPLATE_DIR=/opt/nuclei-templates
SECPLAT_SCAN_TIMEOUT_SECONDS=7200
SECPLAT_CORS_ORIGINS=["http://localhost:3000"]
SECPLAT_WORKSPACE_ROOT=./local-projects
